{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -m devguard hook claude-code",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m devguard hook claude-code",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
